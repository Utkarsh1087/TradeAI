# ==============================================================================
# TradeAI — Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local and add your API keys.
# If no keys are provided, TradeAI automatically uses its deterministic
# quantitative intelligence fallback engine with 100% offline functionality.

# 1. Groq Cloud API (Recommended for ultra-fast LPU inference)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 2. Google Gemini API (Alternative fast LLM provider)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 3. OpenAI API (Optional fallback)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
